[Unit]
Description=AI Diary web viewer (diaryweb)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/ai-dictaphone-diary
ExecStart=/root/projects/ai-dictaphone-diary/diaryweb
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
