# nen.zenai.space — веб-вьювер дневника (diaryweb, 127.0.0.1:8070).
server {
    server_name nen.zenai.space;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8070;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/nen.zenai.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/nen.zenai.space/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = nen.zenai.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name nen.zenai.space;

    listen 80;
    listen [::]:80;
    return 404; # managed by Certbot


}